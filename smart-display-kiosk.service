[Unit]
Description=Smart Display Kiosk (Cage + Chromium)
# no waiting for the network: the browser opens its boot page from disk and
# waits for the server itself (static/boot.html, docs/boot.md)
After=smart-display-server.service systemd-user-sessions.service plymouth-start.service
Wants=smart-display-server.service
# the screen is the wall's, not a login prompt's (other consoles still work: Ctrl+Alt+F2)
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=das
Group=das
SupplementaryGroups=render video input
Environment="WLR_LIBINPUT_NO_DEVICES=1"
Environment="WLR_BACKENDS=drm,libinput"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="WAYLAND_DISPLAY=wayland-0"
ExecStartPre=/usr/bin/mkdir -p /run/user/1000
ExecStartPre=/usr/bin/chown das:das /run/user/1000
ExecStartPre=/usr/bin/chmod 700 /run/user/1000
# the boot splash leaves its last frame (the standby light) up until cage draws
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/home/das/projects/smart-display/start-kiosk.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
