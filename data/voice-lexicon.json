{
	"read": "What the wall's voice says for what it trips on. 'acronyms' are replaced whole-word and case-sensitively; 'rewrites' are regex pattern -> replacement, applied in order, after the acronyms (python `re` syntax; groups referenced as \\1, \\2). The voice box re-reads this file the moment it changes — a half-written save keeps the last good copy — so edit away; no restart needed. WALL_VOICE_LEXICON points at another file. Measured in voice-tests/ (see its README).",
	"acronyms": {
		"API": "A P I",
		"APIs": "A P I s",
		"api": "A P I",
		"CLI": "C L I",
		"CPU": "C P U",
		"GPU": "G P U",
		"GPUs": "G P U s",
		"HTTP": "H T T P",
		"HTTPS": "H T T P S",
		"JSON": "Jason",
		"json": "Jason",
		"npx": "N P X",
		"SSH": "S S H",
		"ssh": "S S H",
		"SSID": "S S I D",
		"STT": "S T T",
		"sudo": "soo doo",
		"TTS": "T T S",
		"URL": "U R L",
		"URLs": "U R L s",
		"UUID": "U U I D",
		"WAV": "wave"
	},
	"rewrites": [
		{ "why": "voicebox.py -> voicebox dot py; only at the end of a filename (example.ts.net is a hostname)", "pattern": "\\b([\\w-]+)\\.pyi?(?![\\w.-])", "replace": "\\1 dot py" },
		{ "pattern": "\\b([\\w-]+)\\.mjs(?![\\w.-])", "replace": "\\1 dot m j s" },
		{ "pattern": "\\b([\\w-]+)\\.tsx?(?![\\w.-])", "replace": "\\1 dot t s" },
		{ "pattern": "\\b([\\w-]+)\\.jsx?(?![\\w.-])", "replace": "\\1 dot j s" },
		{ "pattern": "\\b([\\w-]+)\\.svelte(?![\\w.-])", "replace": "\\1 dot svelte" },
		{ "pattern": "\\b([\\w-]+)\\.jsonl(?![\\w.-])", "replace": "\\1 dot jason l" },
		{ "pattern": "\\b([\\w-]+)\\.json(?![\\w.-])", "replace": "\\1 dot jason" },
		{ "pattern": "\\b([\\w-]+)\\.ya?ml(?![\\w.-])", "replace": "\\1 dot yaml" },
		{ "pattern": "\\b([\\w-]+)\\.sh(?![\\w.-])", "replace": "\\1 dot s h" },
		{ "pattern": "\\b([\\w-]+)\\.md(?![\\w.-])", "replace": "\\1 dot m d" },
		{ "pattern": "\\bnode_modules\\b", "replace": "node modules" },
		{ "pattern": "\\bsvelte-check\\b", "replace": "svelte check" },
		{ "pattern": "\\bsystemctl\\b", "replace": "system control" },
		{ "pattern": "(^|\\s)~/(?=\\S)", "replace": "\\1home " },
		{ "pattern": "(^|\\s)\\.env\\b", "replace": "\\1dot env" },
		{ "why": "ptts 0.4.1 -> ptts 0 point 4 point 1, but 127.0.0.1 is an IP, not a version", "pattern": "(?<![\\d.])(\\d+)\\.(\\d+)\\.(\\d+)(?![\\d.])", "replace": "\\1 point \\2 point \\3" },
		{ "pattern": "\\s*(?:->|→)\\s*", "replace": " to " }
	]
}
