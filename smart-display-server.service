[Unit]
Description=Smart Display Dashboard Server
# it answers on localhost straight away and fetches when the network comes up;
# waiting for network-online held the whole wall up for up to half a minute
After=network.target

[Service]
Type=simple
User=das
WorkingDirectory=/home/das/projects/smart-display
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="TZ=America/New_York"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
ExecStart=/usr/bin/node src/ws-server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
