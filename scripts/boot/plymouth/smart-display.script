# The wall's standby light: the same soft dot, in the same place, breathing at
# the same pace as static/boot.html and src/app.html, so the boot splash, the
# browser's boot page and the wall's page read as one thing. Keep them in step.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

light.image = Image("light.png");
light.sprite = Sprite(light.image);
light.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - light.image.GetWidth() / 2);
light.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - light.image.GetHeight() / 2);
light.sprite.SetOpacity(0.45);

# refresh runs 50 times a second: one breath every 3.2 s (160 frames), 0.45 to 1
frame = 0;
fun refresh_callback() {
	frame++;
	light.sprite.SetOpacity(0.725 - 0.275 * Math.Cos(frame / 160 * 2 * Math.Pi));
}
Plymouth.SetRefreshFunction(refresh_callback);

# a password prompt (disk encryption) still has to be answerable: show it plainly
fun display_password_callback(prompt, bullets) {
	prompt_text.image = Image.Text(prompt + "  " + bullets, 0.95, 0.94, 0.9);
	prompt_text.sprite = Sprite(prompt_text.image);
	prompt_text.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt_text.image.GetWidth() / 2);
	prompt_text.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + 60);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
	prompt_text.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
