[Unit]
Description=Smart Display: AirPlay speaker (shairport-sync)
After=pipewire-pulse.service sound.target avahi-daemon.service
Wants=pipewire-pulse.service

[Service]
Type=simple
Environment=DASHBOARD_URL=http://localhost:3000
ExecStart=/home/das/projects/smart-display/scripts/airplay-run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
